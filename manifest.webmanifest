{
  "name": "Plotoria – Funktionsplotter",
  "short_name": "Plotoria",
  "description": "Graphen für Arbeitsblätter und Prüfungen erstellen und maßstabsgetreu exportieren.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FBF4EC",
  "theme_color": "#FBF4EC",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/json": [".plotoria"] } }
  ]
}
